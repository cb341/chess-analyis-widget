#!/usr/bin/env ruby
# frozen_string_literal: true

require "webrick"
require "uri"
require_relative "../app/controllers/analyses_controller"
require_relative "../config/application"
require_relative "../config/route_set"

controller = AnalysesController.new

server = WEBrick::HTTPServer.new(
  BindAddress: AnalysisApp.host,
  Port: AnalysisApp.port,
  DocumentRoot: AnalysisApp::PUBLIC_ROOT
)

server.mount_proc("/") do |request, response|
  route = ANALYSIS_ROUTES.find do |candidate|
    candidate[:path] == request.path &&
      (candidate[:verb] == request.request_method || (request.request_method == "HEAD" && candidate[:verb] == "GET"))
  end

  case route && [route[:controller], route[:action]]
  when ["analyses", "new"]
    response["Content-Type"] = "text/html; charset=utf-8"
    response.body = (request.request_method == "HEAD") ? "" : controller.new
  when ["analyses", "create"]
    response["Content-Type"] = "text/html; charset=utf-8"
    params = URI.decode_www_form(request.body.to_s).to_h
    response.body = controller.create(params)
  else
    response.status = 404
    response["Content-Type"] = "text/plain; charset=utf-8"
    response.body = "Not found"
  end
end

trap("INT") { server.shutdown }
puts "Listening on http://#{AnalysisApp.host}:#{AnalysisApp.port}"
server.start
