<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Chess Analysis Widget</title>
    <link rel="stylesheet" href="/app.css">
    <link rel="stylesheet" href="/chess-widget.css">
  </head>
  <body>
    <main class="page wide">
      <header class="about-header">
        <h1>Chess Analysis Widget</h1>
        <a href="https://github.com/cb341/chess-widget" class="analyses-link" target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:6px;margin-bottom:12px">
          <svg height="16" width="16" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor" style="flex-shrink:0"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>cb341/chess-widget
        </a>
        <p class="about-tagline">Embeddable move-by-move game analysis. Paste a PGN, get a navigable board with engine annotations.</p>
        <ul class="about-features">
          <li>Stockfish engine evaluation &mdash; hosted on <a href="https://deplo.io" target="_blank" rel="noopener">deplo.io</a></li>
          <li>Blunders, mistakes &amp; brilliant moves marked</li>
          <li>Eval bar &amp; eval-over-time chart</li>
          <li>No build step &mdash; single JS file, self-contained data</li>
          <li>Keyboard navigation</li>
        </ul>
        <div class="about-ctas">
          <%= link_to "Analyze a game →", new_analysis_path, class: "btn-analyze" %>
          <%= link_to "View saved analyses →", analyses_path, class: "analyses-link" %>
        </div>
      </header>

      <script type="application/x-gzip-json" id="game-data"><%= h(@demo_gz) %></script>
      <div class="widget-preview-wrap">
        <chess-widget data-source="game-data"></chess-widget>
      </div>
    </main>
    <script src="/chess-widget.js"></script>
  </body>
</html>
