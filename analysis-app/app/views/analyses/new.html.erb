<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Chess Analysis</title>
    <%= csrf_meta_tags %>
    <link rel="stylesheet" href="/app.css">
  </head>
  <body>
    <main class="page analysis-form-page">
      <h1>Chess Analysis</h1>
      <% if @error %>
        <p class="error"><%= h(@error) %></p>
      <% end %>
      <%= form_with url: analyses_path, method: :post, local: true, class: "analysis-form" do |form| %>
        <%= form.label :pgn, "PGN" %>
        <%= form.text_area :pgn, rows: 18, value: @pgn %>
        <%= form.submit "Analyze" %>
      <% end %>
    </main>
  </body>
</html>
