<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Chess Analysis</title>
    <%= csrf_meta_tags %>
    <link rel="stylesheet" href="/app.css">
  </head>
  <body>
    <main class="page wide analysis-form-page">
      <header class="form-header">
        <h1>Chess Analysis</h1>
        <p class="form-subtitle">Paste a PGN to get move-by-move engine evaluation and annotations.</p>
        <ul class="form-meta">
          <li>
            <% if @stockfish_available %>
              <span class="meta-badge meta-ok">Engine</span>
              <%= h(@stockfish_version || "Stockfish") %>
            <% else %>
              <span class="meta-badge meta-warn">Engine</span>
              Fallback (material count) — Stockfish not found
            <% end %>
          </li>
          <li><span class="meta-badge">Embed</span> Self-contained widget, no API calls after analysis</li>
          <li><span class="meta-badge">PGN</span> Standard PGN with optional <code>{comments}</code> supported</li>
        </ul>
      </header>
      <% if @error %>
        <p class="error"><%= h(@error) %></p>
      <% end %>
      <%= link_to "View saved analyses →", analyses_path, class: "analyses-link" %>
      <%= form_with url: analyses_path, method: :post, local: true, class: "analysis-form-card" do |form| %>
        <div class="pgn-field">
          <%= form.label :pgn, "PGN", class: "pgn-label" %>
          <%= form.text_area :pgn, rows: 16, value: @pgn, placeholder: "[Event \"Live Chess\"]\n[White \"Player1\"]\n[Black \"Player2\"]\n\n1. e4 e5 2. Nf3 Nc6 ..." %>
        </div>
        <div class="form-actions">
          <%= form.submit "Analyze", class: "btn-analyze" %>
        </div>
      <% end %>
    </main>
  </body>
</html>
