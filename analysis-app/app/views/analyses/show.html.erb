<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Chess Analysis Result</title>
    <link rel="stylesheet" href="/app.css">
    <link rel="stylesheet" href="/chess-widget.css">
  </head>
  <body>
    <main class="page wide">
      <nav><a href="/">Analyze another PGN</a> · <a href="/admin/">Admin</a></nav>
      <h1>Analysis Result</h1>
      <% if @analysis_id %>
        <p class="summary">Analysis ID <code><%= h(@analysis_id) %></code> · <a href="/admin/analyses/<%= h(@analysis_id) %>">Admin detail</a></p>
      <% end %>
      <dl class="metadata">
        <% @payload[:metadata].each do |key, value| %>
          <div>
            <dt><%= h(key) %></dt>
            <dd>
              <% if value.to_s.start_with?("http://", "https://") %>
                <a href="<%= h(value) %>"><%= h(value) %></a>
              <% else %>
                <%= h(value) %>
              <% end %>
            </dd>
          </div>
        <% end %>
      </dl>
      <% unless @payload.dig(:analyzer, :stockfish_available) %>
        <p class="error">Stockfish was not available for this run. Move ratings use the fallback material evaluator and are approximate.</p>
      <% end %>
      <p class="summary"><%= h(@payload[:summary]) %></p>
      <script type="application/json" id="game-data"><%= raw json_escape(@payload_json) %></script>
      <chess-widget data-source="game-data"></chess-widget>
      <details class="collapsible">
        <summary>Verbose Markdown Analysis</summary>
        <pre class="markdown-analysis"><%= h(@payload[:markdown_analysis]) %></pre>
      </details>
      <details class="collapsible">
        <summary>Analysis JSON</summary>
        <textarea class="copy-text" readonly rows="14"><%= h(@payload_json) %></textarea>
      </details>
      <details class="collapsible">
        <summary>Analysis JSON Minified</summary>
        <pre id="analysis-json-minified"><%= h(@payload_json_minified) %></pre>
      </details>
      <h2>Embed This Analysis</h2>
      <p class="summary">Copy this widget block into another page. It includes the minified analysis JSON and makes no API calls.</p>
      <details class="collapsible">
        <summary>&lt;widget&gt;</summary>
        <button class="copy-button" type="button" data-copy-target="embed-widget">Copy widget</button>
        <pre id="embed-widget"><%= h(@embed_widget) %></pre>
      </details>
      <details class="collapsible">
        <summary>Widget configuration</summary>
        <dl class="config-list">
          <div>
            <dt><code>widget-title="Live Chess"</code></dt>
            <dd>Sets the title shown in the widget header. If omitted, the widget uses the PGN event name.</dd>
          </div>
          <div>
            <dt><code>hide-author</code></dt>
            <dd>Hides the player/author line in the widget header. <code>hide-players</code> is also accepted.</dd>
          </div>
          <div>
            <dt><code>open-panels="bookmarks summary moves"</code></dt>
            <dd>Opens selected panels on load. Available panels: <code>bookmarks</code>, <code>controls</code>, <code>eval</code>, <code>chart</code>, <code>current</code>, <code>summary</code>, <code>moves</code>.</dd>
          </div>
          <div>
            <dt><code>collapsed-panels="eval chart controls"</code></dt>
            <dd>Forces selected panels closed on load. This overrides the default open state.</dd>
          </div>
          <div>
            <dt><code>sound="off"</code></dt>
            <dd>Disables move sounds.</dd>
          </div>
          <div>
            <dt><code>orientation="black"</code></dt>
            <dd>Renders the board from Black's perspective. The default is White.</dd>
          </div>
        </dl>
      </details>
      <details class="collapsible">
        <summary>Text Analysis</summary>
        <pre><%= h(@payload[:text_analysis]) %></pre>
      </details>
    </main>
    <script src="/chess-widget.js"></script>
    <script>
      document.addEventListener("click", async function (event) {
        const button = event.target.closest("[data-copy-target]");
        if (!button) return;

        const target = document.getElementById(button.dataset.copyTarget);
        const text = target && "value" in target ? target.value : target?.textContent;
        if (!text) return;

        try {
          await navigator.clipboard.writeText(text);
        } catch {
          const scratch = document.createElement("textarea");
          scratch.value = text;
          scratch.setAttribute("readonly", "");
          scratch.style.position = "fixed";
          scratch.style.opacity = "0";
          document.body.appendChild(scratch);
          scratch.select();
          document.execCommand("copy");
          scratch.remove();
        }

        button.textContent = "Copied";
        window.setTimeout(function () {
          button.textContent = "Copy";
        }, 1200);
      });
    </script>
  </body>
</html>
