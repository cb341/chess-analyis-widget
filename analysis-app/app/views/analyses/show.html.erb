<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Chess Analysis Result</title>
    <link rel="stylesheet" href="/app.css">
    <link rel="stylesheet" href="/chess-widget.css">
  </head>
  <body>
    <main class="page wide">
      <nav><a href="/">Analyze another PGN</a> · <%= link_to "All analyses", analyses_path %></nav>
      <h1>Analysis Result</h1>
      <% if @analysis_id %>
        <p class="summary">Analysis ID <code><%= h(@analysis_id) %></code></p>
      <% end %>
      <dl class="metadata">
        <% @payload[:metadata].each do |key, value| %>
          <div>
            <dt><%= h(key) %></dt>
            <dd>
              <% if value.to_s.start_with?("http://", "https://") %>
                <a href="<%= h(value) %>"><%= h(value) %></a>
              <% else %>
                <%= h(value) %>
              <% end %>
            </dd>
          </div>
        <% end %>
      </dl>
      <% unless @payload.dig(:analyzer, :stockfish_available) %>
        <p class="error">Stockfish was not available for this run. Move ratings use the fallback material evaluator and are approximate.</p>
      <% end %>
      <p class="summary"><%= h(@payload[:summary]) %></p>

      <script type="application/x-gzip-json" id="game-data"><%= h(@widget_payload_gz) %></script>
      <div class="widget-preview-wrap">
        <chess-widget id="the-widget" data-source="game-data"></chess-widget>
      </div>

      <section class="widget-customizer">
        <h2>Customize Widget</h2>
        <form id="widget-customizer-form">
          <fieldset>
            <legend>Panels</legend>
            <% %w[bookmarks controls eval chart current summary moves].each do |panel| %>
              <label class="panel-toggle-label">
                <span class="panel-name"><%= panel %></span>
                <select name="panel-<%= panel %>" data-panel="<%= panel %>" class="panel-state-select">
                  <option value="default">default</option>
                  <option value="open">open</option>
                  <option value="closed">closed</option>
                  <option value="hidden">hidden</option>
                </select>
              </label>
            <% end %>
          </fieldset>
          <fieldset>
            <legend>Options</legend>
            <label><input type="checkbox" name="sound-off"> Disable sound</label>
            <label>
              Orientation:
              <select name="orientation">
                <option value="">White (default)</option>
                <option value="black">Black</option>
              </select>
            </label>
            <label>
              Title: <input type="text" name="widget-title" placeholder="(from PGN)">
            </label>
            <label>
              Start at ply: <input type="number" name="initial-ply" min="0" value="0" style="width:5em">
            </label>
          </fieldset>
        </form>

        <details class="collapsible" open>
          <summary>&lt;widget&gt; snippet</summary>
          <button class="copy-button" type="button" data-copy-target="embed-widget">Copy widget</button>
          <pre id="embed-widget" class="wrap-pre"><%= h(@embed_widget) %></pre>
        </details>
        <details class="collapsible">
          <summary>Widget JSON (minified)</summary>
          <pre id="widget-json-minified"><%= h(@widget_payload_json) %></pre>
        </details>
      </section>

      <details class="collapsible">
        <summary>Verbose Markdown Analysis</summary>
        <pre class="markdown-analysis"><%= h(@payload[:markdown_analysis]) %></pre>
      </details>
      <details class="collapsible">
        <summary>Analysis JSON</summary>
        <textarea class="copy-text" readonly rows="14"><%= h(@payload_json) %></textarea>
      </details>
      <details class="collapsible">
        <summary>Text Analysis</summary>
        <pre><%= h(@payload[:text_analysis]) %></pre>
      </details>

      <h2>Board Positions</h2>
      <div class="board-list">
        <% @payload[:positions].each do |position| %>
          <article class="board-card">
            <h3>
              Ply <%= h(position[:ply]) %>
              <% if position[:san] %>
                &nbsp;<%= h(position[:san]) %>
                <% annotation = position.dig(:annotation_detail, :kind) || position[:annotation] %>
                <% if annotation && annotation != "good" %>
                  &nbsp;<span class="annotation-badge annotation-<%= h(annotation) %>"><%= h(annotation) %></span>
                <% end %>
              <% else %>
                &nbsp;Start
              <% end %>
            </h3>
            <pre><%= h(board_text(position)) %></pre>
          </article>
        <% end %>
      </div>
    </main>
    <script src="/chess-widget.js"></script>
    <script>
      (function () {
        var widget = document.getElementById("the-widget");
        var form = document.getElementById("widget-customizer-form");
        var embedPre = document.getElementById("embed-widget");

        function applyCustomization() {
          var openPanels = [], collapsedPanels = [], hiddenPanels = [];
          form.querySelectorAll("[data-panel]").forEach(function (sel) {
            var panel = sel.dataset.panel;
            if (sel.value === "open") openPanels.push(panel);
            else if (sel.value === "closed") collapsedPanels.push(panel);
            else if (sel.value === "hidden") hiddenPanels.push(panel);
          });
          var soundOff = form.querySelector('[name="sound-off"]').checked;
          var orientation = form.querySelector('[name="orientation"]').value;
          var title = form.querySelector('[name="widget-title"]').value.trim();
          var initialPly = parseInt(form.querySelector('[name="initial-ply"]').value, 10) || 0;

          setAttr("open-panels", openPanels.join(" "));
          setAttr("collapsed-panels", collapsedPanels.join(" "));
          setAttr("hidden-panels", hiddenPanels.join(" "));
          setAttr("sound", soundOff ? "off" : "");
          setAttr("orientation", orientation);
          setAttr("widget-title", title);
          setAttr("initial-ply", initialPly > 0 ? String(initialPly) : "");

          updateSnippet(openPanels, collapsedPanels, hiddenPanels, soundOff, orientation, title, initialPly);
        }

        function setAttr(name, value) {
          if (value) widget.setAttribute(name, value);
          else widget.removeAttribute(name);
        }

        function updateSnippet(openPanels, collapsedPanels, hiddenPanels, soundOff, orientation, title, initialPly) {
          var widgetCssUrl = "<%= h(request.base_url) %>/chess-widget.css";
          var widgetJsUrl = "<%= h(request.base_url) %>/chess-widget.js";
          var attrs = "";
          if (title) attrs += ' widget-title="' + escapeAttr(title) + '"';
          if (openPanels.length) attrs += ' open-panels="' + escapeAttr(openPanels.join(" ")) + '"';
          if (collapsedPanels.length) attrs += ' collapsed-panels="' + escapeAttr(collapsedPanels.join(" ")) + '"';
          if (hiddenPanels.length) attrs += ' hidden-panels="' + escapeAttr(hiddenPanels.join(" ")) + '"';
          if (soundOff) attrs += ' sound="off"';
          if (orientation) attrs += ' orientation="' + escapeAttr(orientation) + '"';
          if (initialPly > 0) attrs += ' initial-ply="' + initialPly + '"';
          var gz = "<%= h(@widget_payload_gz) %>";
          embedPre.textContent =
            '<link rel="stylesheet" href="' + widgetCssUrl + '">\n' +
            '<script type="application/x-gzip-json" id="game-data">' + gz + '<\/script>\n' +
            '<chess-widget data-source="game-data"' + attrs + '><\/chess-widget>\n' +
            '<script src="' + widgetJsUrl + '"><\/script>';
        }

        function escapeAttr(s) {
          return s.replace(/&/g, "&amp;").replace(/"/g, "&quot;");
        }

        form.addEventListener("change", applyCustomization);
        form.addEventListener("input", applyCustomization);

        document.addEventListener("click", async function (event) {
          var button = event.target.closest("[data-copy-target]");
          if (!button) return;
          var target = document.getElementById(button.dataset.copyTarget);
          var text = target && "value" in target ? target.value : target && target.textContent;
          if (!text) return;
          try {
            await navigator.clipboard.writeText(text);
          } catch (_) {
            var scratch = document.createElement("textarea");
            scratch.value = text;
            scratch.setAttribute("readonly", "");
            scratch.style.position = "fixed";
            scratch.style.opacity = "0";
            document.body.appendChild(scratch);
            scratch.select();
            document.execCommand("copy");
            scratch.remove();
          }
          button.textContent = "Copied";
          window.setTimeout(function () { button.textContent = "Copy"; }, 1200);
        });
      })();
    </script>
  </body>
</html>
