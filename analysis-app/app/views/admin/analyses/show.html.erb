<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Admin · <%= h(title_for(@analysis)) %></title>
    <link rel="stylesheet" href="/app.css">
  </head>
  <body>
    <main class="page wide">
      <nav><a href="/admin">All analyses</a> · <a href="/">New analysis</a></nav>
      <h1><%= h(title_for(@analysis)) %></h1>
      <p class="summary"><%= h(@analysis.summary) %></p>

      <section class="admin-grid">
        <div>
          <h2>Metadata</h2>
          <table class="admin-table">
            <tbody>
              <% @analysis.metadata.each do |key, value| %>
                <tr>
                  <th><%= h(key) %></th>
                  <td><%= h(value) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <div>
          <h2>Totals</h2>
          <table class="admin-table">
            <tbody>
              <tr><th>Moves</th><td><%= h(@analysis.moves.length) %></td></tr>
              <tr><th>Boards</th><td><%= h(@analysis.positions.length) %></td></tr>
              <tr><th>Created</th><td><%= h(@analysis.created_at) %></td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <h2>Moves</h2>
      <table class="admin-table">
        <thead>
          <tr>
            <th>Ply</th>
            <th>Move</th>
            <th>Color</th>
            <th>Annotation</th>
            <th>Eval</th>
          </tr>
        </thead>
        <tbody>
          <% @analysis.moves.each do |move| %>
            <tr>
              <td><%= h(move["ply"]) %></td>
              <td><%= h(move["move_number"]) %>. <%= h(move["san"]) %></td>
              <td><%= h(move["color"]) %></td>
              <td><%= h(move["annotation"]) %></td>
              <td><%= h(move.dig("eval_after", "type")) %> <%= h(move.dig("eval_after", "value")) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>

      <h2>Boards</h2>
      <div class="board-list">
        <% @analysis.positions.each do |position| %>
          <article class="board-card">
            <h3>Ply <%= h(position["ply"]) %> <%= h(position["san"]) %></h3>
            <pre><%= h(board_text(position)) %></pre>
          </article>
        <% end %>
      </div>
    </main>
  </body>
</html>
