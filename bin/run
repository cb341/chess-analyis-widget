#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

if [ ! -f .env ]; then
  echo ".env missing. Run bin/setup first." >&2
  exit 1
fi

if ! command -v mise >/dev/null 2>&1; then
  echo "mise not found. Install mise so Rails runs with .mise.toml:" >&2
  echo "  https://mise.jdx.dev/getting-started.html" >&2
  exit 1
fi

cd analysis-app
mise exec -- bundle exec rails db:prepare
mise exec -- bundle exec rails server "$@"
