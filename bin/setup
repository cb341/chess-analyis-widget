#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

STOCKFISH_VERSION="sf_18"
STOCKFISH_DIR="analysis-app/vendor/stockfish"
STOCKFISH_BIN="$STOCKFISH_DIR/stockfish"
BASE_URL="https://github.com/official-stockfish/Stockfish/releases/download/$STOCKFISH_VERSION"

if [ ! -f .env ]; then
  cp .env.example .env
  echo "Created .env from .env.example."
fi

if ! command -v bun >/dev/null 2>&1; then
  echo "bun not found. Install Bun before setup:" >&2
  echo "  https://bun.sh/docs/installation" >&2
  exit 1
fi

if ! command -v ruby >/dev/null 2>&1; then
  echo "ruby not found. Install Ruby 3.3+ before setup." >&2
  exit 1
fi

if ! command -v bundle >/dev/null 2>&1; then
  echo "bundler not found. Install it with: gem install bundler" >&2
  exit 1
fi

bun install

if ruby -e "exit Gem::Version.new(RUBY_VERSION) >= Gem::Version.new('3.0') ? 0 : 1"; then
  bundle config set path vendor/bundle
  bundle install
  bundle config set --local path vendor/bundle
  (cd analysis-app && bundle config set path vendor/bundle && bundle install)
else
  echo "Skipping Ruby lint gems: StandardRB requires Ruby 3.0+, current Ruby is $(ruby -v)."
  echo "Use Docker/CI or install Ruby 3.x to run the full Ruby lint locally."
fi

if [ ! -x "$STOCKFISH_BIN" ]; then
  mkdir -p "$STOCKFISH_DIR"
  case "$(uname -s)-$(uname -m)" in
    Darwin-arm64)
      STOCKFISH_ARCHIVE="stockfish-macos-m1-apple-silicon.tar"
      ;;
    Darwin-x86_64)
      STOCKFISH_ARCHIVE="stockfish-macos-x86-64-avx2.tar"
      ;;
    Linux-x86_64)
      STOCKFISH_ARCHIVE="stockfish-ubuntu-x86-64-avx2.tar"
      ;;
    *)
      echo "Unsupported Stockfish auto-install platform: $(uname -s)-$(uname -m)" >&2
      echo "Install Stockfish 18 manually and set STOCKFISH_PATH in .env." >&2
      exit 1
      ;;
  esac

  tmpdir="$(mktemp -d)"
  curl -fsSL "$BASE_URL/$STOCKFISH_ARCHIVE" -o "$tmpdir/stockfish.tar"
  tar -xf "$tmpdir/stockfish.tar" -C "$tmpdir"
  found="$(find "$tmpdir" -type f -name 'stockfish*' -perm -111 | head -n 1)"
  cp "$found" "$STOCKFISH_BIN"
  chmod +x "$STOCKFISH_BIN"
  rm -rf "$tmpdir"
  echo "Installed Stockfish 18 to $STOCKFISH_BIN."
fi

(cd analysis-app && bundle exec rails db:prepare)

echo "Setup complete."
